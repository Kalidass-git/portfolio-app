{
  "appId": "com.familywealth.app",
  "appName": "Family Wealth",
  "webDir": "www",
  "backgroundColor": "#f1f3ef",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#0f5a47",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "native",
      "style": "LIGHT"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#0f5a47"
    }
  }
}
